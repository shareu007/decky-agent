{
  "name": "decky-agent",
  "version": "0.1.9",
  "description": "A controller-friendly coding agent for Steam Deck, powered by Codex or compatible APIs.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "test:frontend": "node --experimental-strip-types --test tests/*.test.ts && node scripts/test-auth-view.mjs",
    "check": "npm test && npm run test:frontend && npm run build",
    "package": "npm run build && python3 scripts/package.py",
    "preview": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vite": "^6.4.0",
    "esbuild": "0.25.12"
  }
}
